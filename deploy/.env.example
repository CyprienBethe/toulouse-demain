# Copy this file to .env (never commit .env) and adapt the values.
# Values marked "hypothèse" are starting points, to adjust with the memory
# measured in the CI report (branch `rapports`, file latest.md).

# Public name of the API, e.g. a free DuckDNS subdomain pointing to the server.
API_DOMAIN=mon-sous-domaine.duckdns.org

# Origin of the static site allowed to call the API (scheme + host, no path).
# For GitHub Pages: https://<github user in lower case>.github.io
SITE_ORIGIN=https://cyprienbethe.github.io

# Repository whose GitHub Releases contain the graph (used by update-graph.sh).
GRAPH_REPOSITORY=CyprienBethe/toulouse-demain

# JVM options for OTP (default for Oracle Cloud A1, 12 GB of RAM).
# -Xmx6g: maximum Java heap. Measured in CI on 14/10/2026: live heap after GC
#   0.87 GB once the graph is loaded, so 6g leaves a wide margin.
# -Xms6g -XX:+AlwaysPreTouch: reserve and touch the whole heap at start.
#   Why: Oracle may reclaim an Always Free A1 instance when, over 7 days, CPU,
#   network AND memory all stay under 20 %. Our server is idle most of the
#   time, so CPU and network will be low; a 6 GB heap held from the start keeps
#   memory at about half of the 12 GB, well above 20 % (hypothèse, à vérifier
#   dans les métriques de la console Oracle ; see docs/adr/0001, section 3).
# Raspberry Pi with less RAM: lower all three values, e.g. "-Xms2g -Xmx2g
#   -XX:+AlwaysPreTouch" and OTP_MEM_LIMIT=3g (hypothèse from the measured
#   live heap; the reclaim rule does not apply at home).
OTP_JAVA_OPTS="-Xms6g -Xmx6g -XX:+AlwaysPreTouch"
# Hard memory limit of the OTP container (heap + JVM overhead). Hypothèse : 8g.
OTP_MEM_LIMIT=8g

# Rate limits (hypothèses, à ajuster) : requests per client IP per window,
# and for all clients together.
RATE_LIMIT_EVENTS=30
RATE_LIMIT_WINDOW=1m
GLOBAL_RATE_LIMIT_EVENTS=600

# Only if the public IP changes (box at home): used by duckdns-update.sh.
# The token is a SECRET: keep it in .env only.
DUCKDNS_SUBDOMAIN=
DUCKDNS_TOKEN=
